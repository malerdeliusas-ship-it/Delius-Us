# Kopier til .env for lokal utvikling, og legg de samme verdiene inn under
# Settings → Environment Variables i Vercel. .env skal aldri i git.

# Nøkkelen fra https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Hvem skjemameldingene skal til. Flere adresser skilles med komma.
KONTAKT_TIL=post@example.no

# Avsenderen. Domenet må være verifisert i Resend. Vi bruker underdomenet
# send.malerdelius.no, slik at MX-oppsettet for e-posten på hoveddomenet
# (one.com) ikke røres.
KONTAKT_FRA=Maler Delius <skjema@send.malerdelius.no>
